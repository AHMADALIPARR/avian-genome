// scale_i32.comp — AVIAN-MORPH Vulkan compute shader (i32 scale kernel).
//
// Mirrors the C11 kernel avian_scale_i32 in src/c11/avian_scale.c:
//   output[i] = input[i] * scale, exact integer arithmetic,
//   for i in [0, count).
//
// Contract (same as the C kernel; see src/c11/CONTRACT.md):
//   - The host validates before dispatch, using the same checks as the
//     C kernel: buffers are non-NULL and non-overlapping, output holds
//     at least count elements, and every product fits in int32. The
//     shader performs the arithmetic only; it does not re-validate.
//     A dispatch on unvalidated buffers is a host error, not a shader
//     error.
//   - The product is formed in 64 bits and then narrowed to int32.
//     The narrowing is safe because the host already verified that
//     every product fits in int32. This matches the C kernel, which
//     forms the product in 64 bits and range-checks before storing.
//   - No cross-element reduction, so element order does not affect
//     the result. Deterministic: the same inputs give the same outputs.
//   - count == 0 is valid. The host dispatches zero workgroups and
//     writes nothing.
//
// Binding layout (set 0):
//   binding 0 — readonly input buffer (int data[])
//   binding 1 — output buffer (int data[])
//   push constant — scale (int), count (uint)
//
// This shader is compiled to SPIR-V and validated with spirv-val.
// It is NOT executed here: there is no GPU on this machine, so the
// CPU-vs-GPU conformance comparison is UNVERIFIED (see CONTRACT.md).

#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    int data[];
} input_buf;

layout(set = 0, binding = 1) buffer OutputBuffer {
    int data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    int  scale;
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    int64_t product = int64_t(input_buf.data[i]) * int64_t(pc.scale);
    output_buf.data[i] = int(product);
}
