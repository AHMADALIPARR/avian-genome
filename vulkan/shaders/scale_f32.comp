// scale_f32.comp — AVIAN-MORPH Vulkan compute shader (f32 scale kernel).
//
// Mirrors the C11 kernel avian_scale_f32 in src/c11/avian_scale.c:
//   output[i] = input[i] * scale, for i in [0, count).
//
// Contract (same as the C kernel; see src/c11/CONTRACT.md):
//   - The host validates before dispatch, using the same checks as the
//     C kernel: buffers are non-NULL and non-overlapping, output holds
//     at least count elements, scale and every input element are finite,
//     and every product is finite. The shader performs the arithmetic
//     only; it does not re-validate. A dispatch on unvalidated buffers
//     is a host error, not a shader error.
//   - One correctly-rounded IEEE 754 single-precision multiply per
//     element. No cross-element reduction, so element order does not
//     affect the result. Deterministic: the same inputs give the same
//     outputs.
//   - count == 0 is valid. The host dispatches zero workgroups and
//     writes nothing.
//
// Binding layout (set 0):
//   binding 0 — readonly input buffer (float data[])
//   binding 1 — output buffer (float data[])
//   push constant — scale (float), count (uint)
//
// This shader is compiled to SPIR-V and validated with spirv-val.
// It is NOT executed here: there is no GPU on this machine, so the
// CPU-vs-GPU conformance comparison is UNVERIFIED (see CONTRACT.md).

#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer InputBuffer {
    float data[];
} input_buf;

layout(set = 0, binding = 1) buffer OutputBuffer {
    float data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    float scale;
    uint  count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    output_buf.data[i] = input_buf.data[i] * pc.scale;
}
